PGUSER=postgres
PGPASSWORD=put-the-new-password-here
PGHOST=127.0.0.1
PGPORT=5433
PGDB=docs_db
GEMINI_API_KEY=put-the-new-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
USE_MOCK_AI=0
UPLOAD_DIR=storage/uploads
FLASK_SECRET_KEY=put-a-long-random-value-here

# --- optional (defaults shown) ---
# COOKIE_SECURE=1          session cookie only over HTTPS (browsers still accept it on http://127.0.0.1)
# BEHIND_PROXY=0           set to 1 when Caddy is in front (trust X-Forwarded-For / -Proto)
# LOGIN_RATE_LIMIT=10 per minute   per IP; raise it only for the Locust load test
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# WEB_THREADS=16
